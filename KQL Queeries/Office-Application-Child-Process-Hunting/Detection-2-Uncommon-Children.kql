let OfficeApps = dynamic([
    "winword.exe", "excel.exe", "powerpnt.exe", "outlook.exe",
    "onenote.exe", "msaccess.exe", "publisher.exe"
]);

let CommonChildren = dynamic([
    "msedge.exe", "msedgewebview2.exe", "chrome.exe", "firefox.exe",
    "teams.exe", "ms-teams.exe", "outlook.exe", "splwow64.exe",
    "protocolhandler.exe", "filecoauth.exe", "winword.exe",
    "powerpnt.exe", "excel.exe", "onenote.exe", "adobe.exe",
    "acrobat.exe", "microsoft.mashup.container.loader.exe"
]);

DeviceProcessEvents
| where Timestamp >= ago(14d)
| where InitiatingProcessFileName in~ (OfficeApps)
| where FileName !in~ (CommonChildren)
| extend CommandLine = tolower(ProcessCommandLine)
| extend RiskScore =
      iff(CommandLine contains "http://"
          or CommandLine contains "https://"
          or CommandLine contains "download"
          or CommandLine contains "invoke-webrequest"
          or CommandLine contains "webclient", 30, 0)
    + iff(CommandLine contains "-enc"
          or CommandLine contains "-encodedcommand"
          or CommandLine contains "frombase64string"
          or CommandLine contains "invoke-expression", 30, 0)
    + iff(CommandLine contains "\appdata\"
          or CommandLine contains "\temp\"
          or CommandLine contains "\public\"
          or CommandLine contains "\downloads\", 20, 0)
    + iff(FileName in~ ("mshta.exe", "rundll32.exe", "regsvr32.exe", "certutil.exe", "bitsadmin.exe"), 20, 0)
| extend RiskLevel = case(
    RiskScore >= 70, "High-priority review",
    RiskScore >= 40, "Medium-priority review",
    "Low-priority review"
)
| project
    Timestamp,
    DeviceName,
    AccountName,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    FileName,
    ProcessCommandLine,
    RiskScore,
    RiskLevel,
    ReportId
| order by RiskScore desc, Timestamp desc
