<!--
  AI-Powered SOC Lab - custom Windows Sysmon detections
  D001 is a child of Wazuh's built-in Sysmon Event ID 1 rule (61603).
  Test live EventChannel traffic; JSON-only tests do not reproduce this parent chain.
-->
<group name="windows,sysmon,soc_windows_baseline,">

  <!-- D001: suspicious PowerShell execution -->
  <rule id="100500" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-executionpolicy\s+bypass|-ep\s+bypass|-windowstyle\s+hidden|-w\s+hidden|downloadstring|invoke-webrequest|start-bitstransfer|frombase64string|\biex\b)</field>
    <description>SOC D001: Suspicious PowerShell execution pattern on $(win.system.computer)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>soc_d001,powershell,</group>
  </rule>

  <!-- D002: encoded PowerShell launched by a non-PowerShell parent.
       Complements existing rule 92057. -->
  <rule id="100501" level="9">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-(?:encodedcommand|enc|enco|en|ec)\b\s+[A-Za-z0-9+/=]{16,}</field>
    <field name="win.eventdata.parentImage" type="pcre2" negate="yes">(?i)\\(powershell|pwsh)\.exe$</field>
    <description>SOC D002: Encoded PowerShell command launched by a non-PowerShell parent on $(win.system.computer)</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
    <group>soc_d002,powershell,encoded_command,</group>
  </rule>

  <!-- D003: whoami /all identity discovery -->
  <rule id="100510" level="7">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\whoami\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s/all(?:\s|$)</field>
    <description>SOC D003: Windows identity and privilege discovery using whoami /all on $(win.system.computer)</description>
    <mitre>
      <id>T1033</id>
    </mitre>
    <group>soc_d003,account_discovery,</group>
  </rule>

</group>
