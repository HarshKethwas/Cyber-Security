<group name="local,windows,bits,">
  <!--
    BITS service lifecycle and misuse monitoring.
    Parent rules to validate against installed Wazuh 4.13.1:
      61104 = Windows System Event ID 7040
      61615 = Sysmon Event ID 13
      sysmon_event1 = Sysmon Event ID 1 process creation group
    IDs 100520-100524 avoid collision with existing repository rule 100510.
  -->
  <rule id="100520" level="3">
    <if_sid>61104</if_sid>
    <field name="win.eventdata.param4" type="pcre2">(?i)^BITS$</field>
    <description>BITS startup type changed: $(win.eventdata.param2) to $(win.eventdata.param3). Lifecycle context, not proof of abuse.</description>
    <group>bits,bits_service_lifecycle,windows,</group>
  </rule>

  <rule id="100521" level="3">
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)^HKLM\\(SYSTEM\\)?(CurrentControlSet|ControlSet[0-9]{3,})\\Services\\BITS\\Start$</field>
    <description>BITS Start registry value changed by $(win.eventdata.image): $(win.eventdata.details)</description>
    <group>bits,bits_registry_change,windows,</group>
  </rule>

  <rule id="100522" level="12">
    <if_sid>100521</if_sid>
    <field name="win.eventdata.details" type="pcre2">(?i)0x00000004</field>
    <description>BITS service startup was set to Disabled by $(win.eventdata.image). Validate authorization and application impact.</description>
    <mitre><id>T1543.003</id></mitre>
    <group>bits,bits_service_disabled,windows,persistence,</group>
  </rule>

  <rule id="100523" level="7">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bsc\.exe"?\s+config\s+BITS\b</field>
    <description>sc.exe invoked to change BITS service configuration by $(win.eventdata.user): $(win.eventdata.commandLine)</description>
    <mitre><id>T1543.003</id></mitre>
    <group>bits,bits_service_admin_tool,windows,</group>
  </rule>

  <rule id="100524" level="6">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)(^|\\)bitsadmin\.exe$</field>
    <description>bitsadmin.exe executed by $(win.eventdata.user): $(win.eventdata.commandLine). Inspect job owner, URL, files, and state.</description>
    <mitre><id>T1197</id></mitre>
    <group>bits,bits_job_tool_execution,windows,</group>
  </rule>
</group>
